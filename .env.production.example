# The names the deployed app reads. No values — this file is committed and the
# repository is public. The real ones live in Coolify's environment for the
# resource, and nowhere else in the repo.

# The database that already exists, reached over the Docker network: the
# container's own 5432, not the 5434 docker-compose.yml publishes to the host.
DATABASE_URL=postgresql://fin:fin@postgres:5432/fin?schema=public

# The one published port. Tailnet only.
WEB_PORT=8090

# The assistant. Whichever of these is set decides which model answers, in this
# order: GEMINI_API_KEY, then ANTHROPIC_API_KEY. With neither, the assistant
# says so plainly and every screen carries on working.
#
# OLLAMA_MODEL is deliberately absent: the Ollama adapter reaches 127.0.0.1,
# which inside a container is the container.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
