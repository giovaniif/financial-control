// Financial Control — persistence schema.
//
// Money columns are BigInt cents, never Float. Dates that mean a calendar day
// are `@db.Date`, never a timestamp: a payday on the 5th is the 5th, and a
// timezone must never be able to shift it onto the 4th.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // A local PostgreSQL, run by docker-compose.yml at the repo root. Nothing
  // sits in front of it, so migrations and the application share one URL — the
  // separate `directUrl` a hosted connection pooler would force is not needed.
  url = env("DATABASE_URL")
}

/// Which way pay moves when the anchor lands on a weekend or a holiday.
enum ShiftPolicy {
  PRECEDING
  FOLLOWING
}

/// The app's configuration. One user, so exactly one row.
model Settings {
  id          String      @id @default("singleton")
  anchorDay   Int
  shiftPolicy ShiftPolicy @default(PRECEDING)
  updatedAt   DateTime    @updatedAt

  @@map("settings")
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
}

/// Somewhere money actually sits. Their sum is the app's starting cash.
model Account {
  id      String      @id @default(uuid())
  name    String
  type    AccountType
  /// Integer cents. Negative is legal — a cheque account can be overdrawn.
  balance BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

enum CycleStatus {
  OPEN
  CLOSED
}

/// One payday cycle: salary date through the day before the next salary date.
model Cycle {
  id String @id @default(uuid())

  /// The month the cycle is named for, `YYYY-MM`. One cycle per month.
  month  String      @unique
  status CycleStatus @default(OPEN)

  /// Integer cents, carried in from the previous cycle's closing balance.
  openingBalance BigInt

  entries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cycles")
}

enum EntryKind {
  INCOME
  FIXED
  VARIABLE
  ALLOCATION
}

enum SettlementStatus {
  PENDING
  PAID
  RECEIVED
  SKIPPED
  OVERDUE
}

enum OriginKind {
  MANUAL
  FROM_TEMPLATE
  FROM_ALLOCATION
  OVERRIDE
}

/// One line in a cycle's ledger.
model LedgerEntry {
  id      String @id @default(uuid())
  cycleId String
  cycle   Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  description String

  /// A calendar day, not an instant: this is what assigns the entry to a cycle.
  dueDate DateTime @db.Date

  kind         EntryKind
  plannedCents BigInt
  actualCents  BigInt?
  status       SettlementStatus @default(PENDING)

  /// An unconfirmed placeholder, kept out of the confirmed-only totals.
  isEstimate Boolean @default(false)

  originKind OriginKind @default(MANUAL)

  /// The template or bucket the entry came from, when it came from one.
  originRef String?

  /// For an OVERRIDE: what the entry was generated from, and what that
  /// generator would have produced, so the override can be reverted.
  overriddenKind OriginKind?
  overriddenRef  String?
  projectedCents BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The ledger's primary read path: a cycle's entries in due-date order.
  @@index([cycleId, dueDate])
  /// Generation is idempotent — one template produces at most one entry per
  /// cycle. Manual entries have a null ref, which PostgreSQL treats as
  /// distinct, so they are not constrained by this.
  @@unique([cycleId, originKind, originRef])
  @@map("ledger_entries")
}

enum Direction {
  IN
  OUT
}

enum TemplateStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// A recurring income or outcome: the engine that fills future cycles.
model RecurringTemplate {
  id        String    @id @default(uuid())
  name      String
  direction Direction

  /// A day of the month. Which of a cycle's two months it lands in is derived.
  dueDayOfMonth Int

  /// Integer cents. The amount before any value-schedule step applies.
  baseAmountCents BigInt

  /// `YYYY-MM`. The cycle the template starts generating from, and optionally
  /// the last one it generates into.
  startMonth String
  endMonth   String?

  status     TemplateStatus @default(ACTIVE)
  isEstimate Boolean        @default(false)

  valueSchedule ValueScheduleStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recurring_templates")
}

/// An amount applying from one cycle onward, until the next step.
model ValueScheduleStep {
  id         String            @id @default(uuid())
  templateId String
  template   RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// `YYYY-MM`, the cycle this amount starts applying from.
  fromMonth   String
  amountCents BigInt

  /// One amount per cycle per template: a second step for the same cycle is a
  /// correction of the first, not an addition to it.
  @@unique([templateId, fromMonth])
  @@map("value_schedule_steps")
}

enum BucketMode {
  GOAL
  ONGOING
}

enum BucketStatus {
  ACTIVE
  ARCHIVED
}

enum AllocationRuleKind {
  PERCENT
  FIXED
}

enum BucketEventKind {
  CONTRIBUTION
  OVERRIDE
  YIELD
  CORRECTION
  WITHDRAWAL
}

/// A pot of savings fed by a rule each cycle.
model Bucket {
  id      String @id @default(uuid())
  name    String
  purpose String @default("")

  /// A real invariant: GOAL carries a target and date, ONGOING carries neither.
  mode             BucketMode
  targetCents      BigInt?
  targetDate       DateTime?  @db.Date

  ruleKind            AllocationRuleKind
  /// Basis points when the rule is a percentage, so 33,33 % stays exact.
  ruleBasisPoints     Int?
  ruleFixedCents      BigInt?

  /// Funding order when the surplus is short. Lower is funded first.
  priority Int

  /// An assumption, used only in the long-range projection.
  expectedYieldBasisPoints Int?

  status BucketStatus @default(ACTIVE)

  events BucketEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buckets")
}

/// Append-only. The balance is the fold over this, never a stored figure.
model BucketEvent {
  id       String @id @default(uuid())
  bucketId String
  bucket   Bucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  kind BucketEventKind

  /// Set on CONTRIBUTION and OVERRIDE: the cycle the rule ran for.
  cycleMonth String?

  /// Set on YIELD, CORRECTION and WITHDRAWAL.
  occurredOn DateTime? @db.Date

  amountCents BigInt?

  /// CORRECTION sets the balance outright rather than adjusting it.
  newBalanceCents BigInt?

  /// What the rule would have contributed, kept on an OVERRIDE.
  ruleWouldHaveBeenCents BigInt?

  /// Required on CORRECTION and WITHDRAWAL — an unexplained balance is what
  /// this log exists to prevent.
  reason String?

  /// Preserves the order events were appended in, which the fold depends on.
  sequence Int

  @@unique([bucketId, sequence])
  @@index([bucketId])
  @@map("bucket_events")
}
