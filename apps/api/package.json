{
  "name": "@fin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fin/contracts": "workspace:*",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@fin/eslint-config": "workspace:*",
    "@fin/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
