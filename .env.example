# Every variable the applications read, with empty values.
#
# Copy the API block into `apps/api/.env`, which is gitignored. Everything runs
# on this machine — there is no hosted environment and no secret store.

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------

# Port the Fastify server binds. Defaults to 3333 when unset.
PORT=

# The local PostgreSQL from docker-compose.yml at the repo root. With the
# credentials as committed there, this is:
#   postgresql://fin:fin@localhost:5434/fin
DATABASE_URL=

# The database the DB-backed tests run against. They truncate every table in
# it, so it must be a dedicated one — the test setup refuses to run against a
# URL whose database name is not `fin_test`. docker-compose creates it:
#   postgresql://fin:fin@localhost:5434/fin_test
TEST_DATABASE_URL=

# Key for the Claude API, which powers the first-run conversation and the
# assistant. Optional: with no key the app wires a model that fails every call
# with an explainable message, first run falls back to a plain form, and every
# figure in the app stays readable. A blank value counts as no key.
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Name a local Ollama model to run the assistant against it instead of the
# Claude API — free and unlimited, for exercising the flow without spending.
# It takes precedence over ANTHROPIC_API_KEY, so a key left here is not
# silently charged when you meant to test locally. Needs `ollama serve`
# running and the model pulled:
#   ollama pull qwen2.5:7b
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------

# Base URL of the API. Leave empty in development: the app then calls `/api` on
# its own origin and Vite proxies it, which is what makes the app reachable
# from another machine. Vite only exposes variables prefixed with `VITE_`.
VITE_API_URL=
