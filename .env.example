# Every variable the applications read, with empty values.
#
# Nothing here is ever filled in and committed — real values live in the
# platform dashboards and in GitHub Environments `dev` and `production`.
#
# For local work, copy the API block into `apps/api/.env`, which is gitignored.

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------

# Port the Fastify server binds. Defaults to 3333 when unset.
PORT=

# Supabase Postgres, pooled through pgBouncer on port 6543. Used by the running
# application. Append `?pgbouncer=true` as Supabase's connection string does.
DATABASE_URL=

# Supabase Postgres, direct connection on port 5432. Used by `prisma migrate`
# only — migrations fail against the pooler.
DIRECT_URL=

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------

# Base URL of the API. Vite only exposes variables prefixed with `VITE_`.
VITE_API_URL=
