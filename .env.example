# Every variable the applications read, with empty values.
#
# Copy the API block into `apps/api/.env`, which is gitignored. Everything runs
# on this machine — there is no hosted environment and no secret store.

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------

# Port the Fastify server binds. Defaults to 3333 when unset.
PORT=

# The local PostgreSQL from docker-compose.yml at the repo root. With the
# credentials as committed there, this is:
#   postgresql://fin:fin@localhost:5434/fin
DATABASE_URL=

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------

# Base URL of the API. Leave empty in development: the app then calls `/api` on
# its own origin and Vite proxies it, which is what makes the app reachable
# from another machine. Vite only exposes variables prefixed with `VITE_`.
VITE_API_URL=
